<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <!-- Colour picker, launched via RunScript(color_picker.py, <target>) from
         Settings > Appearance (see lib/color_picker.py). Layout and
         palette must match lib/color_picker.py (_PALETTE, _CONTROL_RECT).
         Left: menu (OK / Custom hex / Default / Cancel), R/G/B sliders (focus a
         row, left/right to change, OK to type a value), and a NOW | NEW bar.
         Right: 36 named swatches (ids 300+). Bottom: the chosen colour's
         name, hex, and which setting it applies to.
         Hand-built rather than Kodi's colorbutton (Nexus+ only). Every focusable
         control has explicit navigation (automatic fallback proved unreliable);
         a control pointing a direction at itself means "don't move". No <font>:
         this addon ships no Font.xml. -->
