<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">101</defaultcontrol>
    <controls>
        <control type="group" id="100">
            <left>1642</left>
            <bottom>96</bottom>
            <width>238</width>
            <height>52</height>
            <!-- Baked button art: control 106 (Text theme: label+icon glyph, no
                 background; Pill theme: translucent pill background) plus control 107
                 (Pill theme only: the same glyph drawn on top, independently tinted).
                 Texture/size are set in Python — see SkipOverlayDialog._apply_layout().
                 Deliberately no <visible> tag:
                 on this system, any <visible> condition on a control in a dialog stacked
                 over fullscreen video — literal constant or Window.Property() alike —
                 never evaluates true, so the control never paints no matter what
                 Control.setVisible()/setProperty() does from Python. Confirmed via an
                 isolated test dialog (unconditional control rendered and persisted; an
                 otherwise-identical Window.Property()-gated control never appeared). -->
            <control type="image" id="106">
                <left>0</left>
                <top>0</top>
                <width>238</width>
                <height>52</height>
                <!-- Initial texture/colordiffuse are a placeholder, not what actually
                     shows: onInit() (see SkipOverlayDialog._apply_layout in
                     lib/skip_overlay.py) always calls setImage()/setColorDiffuse()
                     with the correct theme/kind texture before the button should be
                     visible. But that first frame, before onInit's Python runs,
                     paints whatever this XML says, and a hardcoded real texture here
                     (previously skip_intro_button.png, unconditionally) flashed the
                     wrong glyph for one frame: always the Text-theme intro art, even
                     for Recap or for the Pill theme, since Python hasn't corrected it
                     yet. Same fix as control 101 below: start fully transparent
                     (00FFFFFF) so that first frame shows nothing instead of the wrong
                     art, rather than a visible swap a moment later. -->
                <texture>swatch.png</texture>
                <colordiffuse>00FFFFFF</colordiffuse>
                <aspectratio>keep</aspectratio>
            </control>
            <!-- Pill-theme only: draws the exact same icon/label glyph texture used by
                 control 106 in Text theme, on top of control 106's pill background here,
                 independently tinted via settings.pill_text_color() (default white, i.e.
                 no added tint). Unused and left fully transparent in Text theme; see
                 SkipOverlayDialog._apply_layout() in lib/skip_overlay.py, which sets its
                 texture/position/size/colour (or blanks it out for Text theme) every time.
                 Declared after control 106 so it paints on top of it. Starts fully
                 transparent for the same reason as control 106 above: a hardcoded real
                 texture here would flash for one frame before onInit's Python corrects it. -->
            <control type="image" id="107">
                <left>0</left>
                <top>0</top>
                <width>238</width>
                <height>52</height>
                <texture>swatch.png</texture>
                <colordiffuse>00FFFFFF</colordiffuse>
                <aspectratio>keep</aspectratio>
            </control>
            <!-- Invisible hit/focus button, sized to match the baked art. Must have an
                 explicit texturefocus/texturenofocus — without one, Kodi falls back to
                 the active skin's own default button chrome for the focused state (this
                 control gets focus immediately via <defaultcontrol>), and that fallback
                 does not fully honor colordiffuse the way an explicit <texture> override
                 does, so the skin's own focus box was showing through behind the art.
                 The referenced file is irrelevant content-wise — colordiffuse makes it
                 fully transparent regardless — it just needs to be a texture that exists. -->
            <control type="button" id="101">
                <left>0</left>
                <top>0</top>
                <width>238</width>
                <height>52</height>
                <label></label>
                <font></font>
                <textcolor>00FFFFFF</textcolor>
                <focusedcolor>00FFFFFF</focusedcolor>
                <texturefocus>skip_intro_button.png</texturefocus>
                <texturenofocus>skip_intro_button.png</texturenofocus>
                <colordiffuse>00FFFFFF</colordiffuse>
            </control>
        </control>
    </controls>
</window>
