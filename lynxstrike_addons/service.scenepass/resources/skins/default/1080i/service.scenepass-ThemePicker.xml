<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <!-- Unified "Preview theme..." dialog, launched via RunScript(theme_picker.py)
         from Settings > Appearance (see lib/theme_picker.py). A miniature TV
         screen with the four corner slots numbered as in the Button position
         setting (1 bottom right, 2 bottom left, 3 top left, 4 top right), each
         drawing the Skip Intro button in the chosen theme (Text/Pill) and the
         current colours. The current corner is full colour, the others dimmed.
         Text/Pill buttons below switch the theme live; clicking a corner saves
         theme + position and closes; Back/ESC closes without changing anything.
         Explicit navigation and no <font>: see the ColorPicker skin. Slot rects
         must match lib/theme_picker.py:_SLOT_RECT. -->
